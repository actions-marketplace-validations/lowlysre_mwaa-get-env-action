{
  "name": "mwaa-get-env-action",
  "version": "1.0.0",
  "description": "GitHub Action that gets details of an Amazon MWAA environment (GetEnvironment).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-exclude=\"src/index.ts\" --test-coverage-lines=95 --test-coverage-functions=95 --test-coverage-branches=90 test/*.test.ts",
    "docs:toc": "node scripts/toc.mjs",
    "check": "npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@aws-sdk/client-mwaa": "^3.1162.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2"
  }
}
